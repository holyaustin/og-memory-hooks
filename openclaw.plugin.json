{
  "id": "0g-memory-hooks",
  "name": "0G Memory Hooks",
  "version": "0.1.0",
  "description": "Persistent agent memory on 0G Storage with TUI commands",
  "main": "dist/index.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "activation": {
    "onStartup": true
  },
  "commands": [
    {
      "name": "0g:upload",
      "description": "Upload current memory to 0G Storage",
      "category": "0G Memory"
    },
    {
      "name": "0g:download",
      "description": "Restore memory from latest 0G checkpoint",
      "category": "0G Memory"
    },
    {
      "name": "0g:status",
      "description": "Check on-chain checkpoint status",
      "category": "0G Memory"
    },
    {
      "name": "0g:help",
      "description": "Show all 0G Memory commands",
      "category": "0G Memory"
    }
  ],
  "hooks": [
    {
      "event": "before_compact",
      "handler": "./dist/hooks/before_compact.js",
      "priority": 90
    },
    {
      "event": "after_restart",
      "handler": "./dist/hooks/after_restart.js",
      "priority": 10
    },
    {
      "event": "heartbeat",
      "handler": "./dist/hooks/heartbeat.js"
    }
  ]
}