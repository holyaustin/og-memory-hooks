{
  "id": "0g-memory-hooks",
  "name": "0G Memory Hooks",
  "version": "0.1.0",
  "description": "Auto-persist agent memory to 0G Storage before compaction.",
  "main": "dist/index.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "activation": {
    "onStartup": true
  },
  "hooks": [
    {
      "event": "before_compact",
      "handler": "./dist/hooks/before_compact.js",
      "priority": 90
    },
    {
      "event": "after_restart",
      "handler": "./dist/hooks/after_restart.js",
      "priority": 10
    },
    {
      "event": "heartbeat",
      "handler": "./dist/hooks/heartbeat.js"
    }
  ]
}